# Public Data Portal / API service keys
# Never commit the real .env.local file.
PUBLIC_DATA_SERVICE_KEY=

# Optional separate keys if each service was issued a different key.
REB_APPLY_RESULT_API_KEY=
REB_SUPPLY_INFO_API_KEY=
LH_SUPPLY_INFO_API_KEY=
LH_NOTICE_API_KEY=
LH_RENTAL_COMPLEX_API_KEY=

# Use only in a server-side function or local development.
PUBLIC_DATA_API_BASE_URL=

# Kakao Local REST API key. Keep this server-side; do not prefix with EXPO_PUBLIC_.
KAKAO_REST_API_KEY=

# Kakao Maps JavaScript key. This is public by design and is used by the map WebView.
EXPO_PUBLIC_KAKAO_JAVASCRIPT_KEY=
