# 서버의 /opt/cheongyak-server/app.env 로 복사해서 값을 채운다. 실제 값이 든 app.env 는 Git 에 올리지 않는다
SPRING_PROFILES_ACTIVE=prod
# DB 값은 Supabase 대시보드 > Connect > Session pooler (줄 끝에 주석을 붙이면 값에 포함되니 주의)
DB_URL=jdbc:postgresql://aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.<프로젝트ref>
DB_PASSWORD=<DB 비밀번호>
JWT_SECRET=<32자 이상 긴 문자열>
GEMINI_API_KEY=<Gemini API 키>
KAKAO_REST_API_KEY=<카카오 REST 키>
PORT=8080
