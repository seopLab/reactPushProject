# 로컬 개발용. 이 파일을 server/.env 로 복사해서 값을 채운다 (server/.env 는 Git 에 올라가지 않음)
# dev 프로필로 실행할 때만 DB 값을 쓴다. local(기본)은 H2 라서 이 값이 없어도 된다
#
# Supabase 대시보드 > Connect > Session pooler 값을 쓴다 (Direct 는 IPv6 전용이라 안 붙을 수 있음)
# 사용자명은 postgres 가 아니라 postgres.<프로젝트ref> 형식
DB_URL=jdbc:postgresql://aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.<프로젝트ref>
DB_PASSWORD=
